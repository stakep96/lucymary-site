# URL publica do WordPress/WooCommerce, sem barra final.
# Esta e uma URL publica, nao uma chave de API. A URL atual e temporaria durante
# a criacao do novo WordPress; substitua pela URL permanente do novo backend apos valida-lo.
WOOCOMMERCE_STORE_URL=https://lucymary.com.br

# Opcionais: use apenas na auditoria local `scripts/woo-readiness.mjs` com chave REST "Read".
# Nunca configure estas variaveis como NEXT_PUBLIC_ nem publique valores reais no Git.
WOOCOMMERCE_READ_KEY=
WOOCOMMERCE_READ_SECRET=

# Segredo aleatorio de 32 caracteres ou mais para o diagnostico protegido da Store API.
# Configure somente no servidor/ambiente da Vercel; nunca use NEXT_PUBLIC_.
STORE_DIAGNOSTIC_TOKEN=

# Opcional: substitua pelo IPv4 do computador na rede Wi-Fi para abrir no celular.
DEV_LAN_HOST=192.168.1.100
